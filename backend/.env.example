# Entorno
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Base de datos PostgreSQL (local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=libreria_db

# Para producción en Render se usa DATABASE_URL (ver render.yaml)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# JWT
# Configurar una clave propia antes de iniciar el servidor.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# 2FA
# Configurar una clave de al menos 16 caracteres.
TWO_FACTOR_ENCRYPTION_KEY=

# Frontend (CORS)
FRONTEND_ORIGINS=http://localhost:5173,https://librer-a-zeta.vercel.app
# Expresión sin delimitadores /.../. Solo previews de este proyecto/equipo.
# Si es inválida, se desactivan previews y se conserva la lista explícita.
FRONTEND_ORIGINS_REGEX=^https://libreria-[a-z0-9-]+-jimenezvegaedinson7-dot\.vercel\.app$

# Proxy trust (0 = no confiar, 1 = primer proxy, etc.)
TRUST_PROXY=0

# ============================================================
# PAYU SANDBOX (Perú)
# ============================================================
# Completar con las credenciales del entorno de pruebas de la cuenta PayU.
PAYU_ACCOUNT_ID=
PAYU_MERCHANT_ID=
PAYU_API_LOGIN=
PAYU_API_KEY=
PAYU_PUBLIC_KEY=
PAYU_TEST=true
# URL pública del backend para notificaciones PayU (configurar en panel PayU)
# PAYU_NOTIFICATION_URL=https://tu-app.onrender.com/api/pagos/webhook

# ============================================================
# EMAIL (Gmail App Password)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_gmail
EMAIL_FROM="MATIDANA <no-reply@tudominio.com>"

# ============================================================
# CLOUDINARY (almacenamiento de imágenes persistente)
# Sin estas variables, las imágenes se guardan en disco local
# y se pierden con cada redeploy de Render.
# ============================================================
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# ============================================================
# UPLOADS
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Asistente Gemini: solo backend. Agregar MANUALMENTE en el entorno al desplegar.
# Nunca usar VITE_GEMINI_API_KEY ni copiar esta clave a React/Flutter o Git.
# Sin clave o si Gemini falla, el asistente usa la busqueda PostgreSQL local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
