# Entorno
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Base de datos PostgreSQL (local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=libreria_db

# Para producción en Render se usa DATABASE_URL (ver render.yaml)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro_cambia_en_produccion_min_32_chars
JWT_EXPIRES_IN=24h

# 2FA
TWO_FACTOR_ENCRYPTION_KEY=clave_32_bytes_para_cifrado_2fa_aes256

# Frontend (CORS)
FRONTEND_ORIGINS=http://localhost:5173

# Proxy trust (0 = no confiar, 1 = primer proxy, etc.)
TRUST_PROXY=0

# ============================================================
